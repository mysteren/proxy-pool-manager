<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="proxy-pool-manager"
        Arguments=""
        InstallLocation="C:\Program Files\mysteren\Proxy Pool Manager">
    </Installer>
    <PackageInformation
        PackageName="Proxy Pool Manager"
        PackageDisplayName="Proxy Pool Manager"
        PublisherName="CN=mysteren"
        PublisherDisplayName="mysteren"
        Version="0.3.2.0"
        PackageDescription="Сбор, проверка и управление пулом прокси">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="io.github.proxy-pool-manager"
                Description="Сбор, проверка и управление пулом прокси"
                DisplayName="Proxy Pool Manager"
                ExecutableName="proxy-pool-manager"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Proxy Pool Manager</DisplayName>
            <PublisherDisplayName>mysteren</PublisherDisplayName>
            <Description>Сбор, проверка и управление пулом прокси</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="proxy-pool-manager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
